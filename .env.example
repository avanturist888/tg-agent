# ── Telegram API credentials ─────────────────────────────────────────────
# Получить: https://my.telegram.org → API development tools → create app
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Номер телефона в международном формате (используется только при логине)
TG_PHONE=+79991234567

# ── Сессия ───────────────────────────────────────────────────────────────
# Файл сессии Telegram. Относительный путь считается от корня проекта.
# ВАЖНО: этот файл = полный доступ к аккаунту. Не коммитить, не копировать.
TG_SESSION=data/session.json

# ── Политика отправки сообщений ─────────────────────────────────────────
#   bot_approval   — агент готовит черновик, карточка с текстом уходит в
#                    бот подтверждений, ты жмёшь кнопку (по умолчанию)
#   human_approval — подтверждение командой `tg approve <id>` в терминале
#   agent_confirm  — достаточно согласия в диалоге с агентом
#   disabled       — отправка запрещена полностью, только чтение
TG_SEND_POLICY=bot_approval

# ── Бот подтверждений ───────────────────────────────────────────────────
# По умолчанию переиспользуется бот уведомлений Claude Code: токен и chat_id
# читаются из его config.env, дублировать их здесь не нужно.
# TG_BOT_ENV_FILE=~/.local/share/cc-telegram-notify/config.env
# Свой бот — раскомментируй и заполни (тогда config.env не читается):
# TG_BOT_TOKEN=123456789:AA...
# TG_APPROVAL_CHAT_ID=123456789
# Если api.telegram.org режет провайдер — запасной маршрут для Bot API:
# TG_BOT_PROXY=socks5://127.0.0.1:10800

# Потолок ожидания кнопки, секунд (агент не висит дольше)
TG_APPROVAL_TIMEOUT_SEC=600

# Сколько минут живёт черновик до автопротухания
TG_DRAFT_TTL_MIN=60

# Окно отмены в чатах с автоотправкой (auto_send = true в chats.toml), секунд:
# столько агент (или ты — кнопкой в боте) может отозвать сообщение
TG_AUTO_SEND_DELAY_SEC=30

# ── Прокси (опционально) ────────────────────────────────────────────────
# Если Telegram недоступен напрямую. Формат: socks5://host:port
# Обычно не нужен: Windows sing-box TUN заворачивает трафик сам.
# TG_PROXY=socks5://127.0.0.1:1080

# ── Лимиты ───────────────────────────────────────────────────────────────
# Сколько голосовых/кружков расшифровывать за один tg_read_chat
# (остальные агент дорасшифрует через tg_transcribe)
TG_TRANSCRIBE_PER_CALL=10

# Предел файла, который агент может отправить (МБ). В карточке бота
# показываются только файлы до 50 МБ — ограничение Bot API.
TG_MAX_FILE_MB=200

# Предел файла, который агент может скачать из чата (МБ) — видео бывают большими
TG_MAX_DOWNLOAD_MB=1024

# Реакции агентов: direct — ставят сразу (только в чатах с send = true,
# каждая пишется в аудит), off — запрещены
TG_REACTIONS=direct


# Потолок сообщений за один запрос агента
TG_MAX_LIMIT=200
