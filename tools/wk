#!/usr/bin/env bash
set -euo pipefail
wk_store=${WK_HOME:-${LOCALAPPDATA:?LOCALAPPDATA is required}/wk}
command -v cygpath >/dev/null 2>&1 && wk_store=$(cygpath -u "$wk_store")
wk_version=933866d37f5009c8e00fe416889feb7cba30a9cc
[[ $(cat "$wk_store/core/$wk_version/VERSION") == "$wk_version" ]] || exit 125
exec bash "$wk_store/core/$wk_version/bin/wk" "$@"
